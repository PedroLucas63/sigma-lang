{
  "Variable Declaration (Explicit)": {
    "prefix": "var",
    "body": [
      "var ${1:name}: ${2|int,float,double,decimal,bool,char,string|} = ${3:value};"
    ],
    "description": "Declare a Sigma variable with explicit type annotation"
  },
  "Variable Declaration (Inferred)": {
    "prefix": "vari",
    "body": [
      "var ${1:name} := ${2:value};"
    ],
    "description": "Declare a Sigma variable with type inference (:=)"
  },
  "Variable Declaration (Zero-Init)": {
    "prefix": "varz",
    "body": [
      "var ${1:name}: ${2|int,float,double,decimal,bool,char,string|};"
    ],
    "description": "Declare a zero-initialized Sigma variable"
  },
  "Chained Relational Comparison": {
    "prefix": "between",
    "body": [
      "${1:lower} <= ${2:x} <= ${3:upper}"
    ],
    "description": "3-operand chained relational comparison with short-circuit evaluation"
  },
  "Interpolated String": {
    "prefix": "strf",
    "body": [
      "\"${1:prefix}: \\${${2:expr}}\""
    ],
    "description": "UTF-8 string with embedded expression interpolation"
  },
  "Print with Newline (println)": {
    "prefix": "println",
    "body": [
      "println(${1:expr});"
    ],
    "description": "Print one or more values separated by spaces followed by a newline"
  },
  "Print without Newline (print)": {
    "prefix": "print",
    "body": [
      "print(${1:expr});"
    ],
    "description": "Print one or more values separated by spaces without a trailing newline"
  },
  "If Statement": {
    "prefix": "if",
    "body": [
      "if (${1:cond}) {",
      "  $0",
      "}"
    ],
    "description": "Conditional if block"
  },
  "If / Else Statement": {
    "prefix": "ife",
    "body": [
      "if (${1:cond}) {",
      "  $2",
      "} else {",
      "  $0",
      "}"
    ],
    "description": "Conditional if / else block"
  }
}
