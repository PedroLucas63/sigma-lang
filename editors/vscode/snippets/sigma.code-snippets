{
  "Variable Declaration (Explicit)": {
    "prefix": "var",
    "body": [
      "var ${1:name}: ${2|int,float,double,decimal,bool,char,string|} = ${3:value};"
    ],
    "description": "Declare a Sigma variable with explicit type annotation"
  },
  "Variable Declaration (Inferred)": {
    "prefix": "vari",
    "body": [
      "var ${1:name} := ${2:value};"
    ],
    "description": "Declare a Sigma variable with type inference (:=)"
  },
  "Variable Declaration (Zero-Init)": {
    "prefix": "varz",
    "body": [
      "var ${1:name}: ${2|int,float,double,decimal,bool,char,string|};"
    ],
    "description": "Declare a zero-initialized Sigma variable"
  },
  "Constant Declaration (Explicit)": {
    "prefix": "const",
    "body": [
      "const ${1:NAME}: ${2|int,float,double,decimal,bool,char,string|} = ${3:value};"
    ],
    "description": "Declare an immutable Sigma constant with explicit type annotation"
  },
  "Constant Declaration (Inferred)": {
    "prefix": "consti",
    "body": [
      "const ${1:NAME} := ${2:value};"
    ],
    "description": "Declare an immutable Sigma constant with type inference (:=)"
  },
  "Chained Relational Comparison": {
    "prefix": "between",
    "body": [
      "${1:lower} <= ${2:x} <= ${3:upper}"
    ],
    "description": "3-operand chained relational comparison with short-circuit evaluation"
  },
  "Interpolated String": {
    "prefix": "strf",
    "body": [
      "\"${1:prefix}: \\${${2:expr}}\""
    ],
    "description": "UTF-8 string with embedded expression interpolation"
  },
  "Print with Newline (println)": {
    "prefix": "println",
    "body": [
      "println(${1:expr});"
    ],
    "description": "Print one or more values separated by spaces followed by a newline"
  },
  "Print without Newline (print)": {
    "prefix": "print",
    "body": [
      "print(${1:expr});"
    ],
    "description": "Print one or more values separated by spaces without a trailing newline"
  },
  "If Statement": {
    "prefix": "if",
    "body": [
      "if (${1:cond}) {",
      "  $0",
      "}"
    ],
    "description": "Conditional if block"
  },
  "If / Else Statement": {
    "prefix": "ife",
    "body": [
      "if (${1:cond}) {",
      "  $2",
      "} else {",
      "  $0",
      "}"
    ],
    "description": "Conditional if / else block"
  },
  "Assert Condition": {
    "prefix": "assert",
    "body": [
      "assert(${1:actual}, ${2:expected}, \"${3:message}\");"
    ],
    "description": "Assert actual equals expected with an optional diagnostic description"
  },
  "Assert Compile Error": {
    "prefix": "asserterr",
    "body": [
      "assert_error(\"${1:E0106}\", \"${2:const X : int;}\", \"${3:message}\");"
    ],
    "description": "Assert that a snippet produces a specific compile/static error code"
  },
  "Tuple Declaration": {
    "prefix": "tuple",
    "body": [
      "var ${1:tup} := (${2:a}, ${3:b});"
    ],
    "description": "Declare an immutable-element tuple"
  },
  "Destructuring Declaration": {
    "prefix": "destruct",
    "body": [
      "var (${1:a}, ${2:b}, _) := ${3:collection};"
    ],
    "description": "Destructure a tuple or static array into variables with optional '_' wildcards"
  },
  "Static Array Declaration": {
    "prefix": "arr",
    "body": [
      "var ${1:arr}: ${2|int,float,double,decimal,bool,char,string|}[${3:3}] = [${4:10, 20, 30}];"
    ],
    "description": "Declare a static-size array T[N] or T[]"
  }
}
