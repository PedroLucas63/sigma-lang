{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Sigma",
  "scopeName": "source.sigma",
  "patterns": [
    { "include": "#comments" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#booleans" },
    { "include": "#numbers" },
    { "include": "#operators" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.sigma",
          "match": "//.*$"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.declaration.var.sigma",
          "match": "\\b(var)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.primitive.sigma",
          "match": "\\b(int|bool)\\b"
        }
      ]
    },
    "booleans": {
      "patterns": [
        {
          "name": "constant.language.boolean.sigma",
          "match": "\\b(true|false)\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "invalid.illegal.numeric.sigma",
          "match": "\\b[0-9][0-9_]*(__|_$)[0-9_]*\\b"
        },
        {
          "name": "constant.numeric.integer.sigma",
          "match": "\\b[0-9](?:_?[0-9])*\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.assignment.sigma",
          "match": ":=|="
        },
        {
          "name": "keyword.operator.arithmetic.sigma",
          "match": "-"
        },
        {
          "name": "punctuation.separator.colon.sigma",
          "match": ":"
        },
        {
          "name": "punctuation.terminator.statement.sigma",
          "match": ";"
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.sigma",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
        }
      ]
    }
  }
}
