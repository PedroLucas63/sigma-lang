{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Sigma",
  "scopeName": "source.sigma",
  "patterns": [
    { "include": "#comments" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#booleans" },
    { "include": "#chars" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#operators" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.sigma",
          "match": "#.*$"
        },
        {
          "name": "comment.block.sigma",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.conditional.sigma",
          "match": "\\b(if|else)\\b"
        },
        {
          "name": "keyword.declaration.var.sigma",
          "match": "\\b(var|const)\\b"
        },
        {
          "name": "support.function.builtin.io.sigma",
          "match": "\\b(println|print)\\b"
        },
        {
          "name": "support.function.builtin.test.sigma",
          "match": "\\b(assert|assert_error)\\b"
        },
        {
          "name": "keyword.operator.assignment.logical.sigma",
          "match": "\\b(and=|or=|xor=)"
        },
        {
          "name": "keyword.operator.logical.sigma",
          "match": "\\b(and|or|xor|not)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.primitive.sigma",
          "match": "\\b(int|float|double|decimal|bool|char|string)\\b"
        }
      ]
    },
    "booleans": {
      "patterns": [
        {
          "name": "constant.language.boolean.sigma",
          "match": "\\b(true|false)\\b"
        }
      ]
    },
    "chars": {
      "patterns": [
        {
          "name": "string.quoted.single.char.sigma",
          "begin": "'",
          "end": "'|$",
          "patterns": [
            { "include": "#escapes" }
          ]
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.sigma",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            { "include": "#escapes" },
            {
              "name": "meta.interpolation.sigma",
              "begin": "\\$\\{",
              "beginCaptures": {
                "0": { "name": "punctuation.section.interpolation.begin.sigma" }
              },
              "end": "\\}",
              "endCaptures": {
                "0": { "name": "punctuation.section.interpolation.end.sigma" }
              },
              "patterns": [
                { "include": "#keywords" },
                { "include": "#booleans" },
                { "include": "#chars" },
                { "include": "#strings" },
                { "include": "#numbers" },
                { "include": "#operators" },
                { "include": "#identifiers" }
              ]
            }
          ]
        }
      ]
    },
    "escapes": {
      "patterns": [
        {
          "name": "constant.character.escape.sigma",
          "match": "\\\\[nrt\\\\'\"0\\$]"
        },
        {
          "name": "invalid.illegal.unknown-escape.sigma",
          "match": "\\\\."
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "invalid.illegal.numeric.sigma",
          "match": "\\b[0-9][0-9_]*(__|_$)[0-9_]*\\b"
        },
        {
          "name": "constant.numeric.decimal.sigma",
          "match": "\\b[0-9](?:_?[0-9])*(?:\\.(?:[0-9](?:_?[0-9])*)?)?(?:[eE][+-]?[0-9](?:_?[0-9])*)?m\\b"
        },
        {
          "name": "constant.numeric.double.sigma",
          "match": "\\b[0-9](?:_?[0-9])*(?:\\.(?:[0-9](?:_?[0-9])*)?)?(?:[eE][+-]?[0-9](?:_?[0-9])*)?d\\b"
        },
        {
          "name": "constant.numeric.float.sigma",
          "match": "\\b(?:[0-9](?:_?[0-9])*\\.(?:[0-9](?:_?[0-9])*)?(?:[eE][+-]?[0-9](?:_?[0-9])*)?f?|[0-9](?:_?[0-9])*(?:[eE][+-]?[0-9](?:_?[0-9])*)f?|[0-9](?:_?[0-9])*f)\\b"
        },
        {
          "name": "constant.numeric.integer.sigma",
          "match": "\\b[0-9](?:_?[0-9])*\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.increment-decrement.sigma",
          "match": "\\+\\+|\\-\\-"
        },
        {
          "name": "keyword.operator.assignment.compound.sigma",
          "match": "//=|<<=|>>=|\\+=|\\-=|\\*=|/=|%=|\\^="
        },
        {
          "name": "keyword.operator.comparison.sigma",
          "match": "==|!=|<=|>="
        },
        {
          "name": "keyword.operator.bitwise.shift.sigma",
          "match": "<<|>>"
        },
        {
          "name": "keyword.operator.comparison.sigma",
          "match": "<|>"
        },
        {
          "name": "keyword.operator.assignment.sigma",
          "match": ":=|="
        },
        {
          "name": "keyword.operator.arithmetic.sigma",
          "match": "//|\\+|\\-|\\*|/|\\^|%"
        },
        {
          "name": "punctuation.separator.colon.sigma",
          "match": ":"
        },
        {
          "name": "punctuation.separator.comma.sigma",
          "match": ","
        },
        {
          "name": "punctuation.parens.sigma",
          "match": "[()]"
        },
        {
          "name": "punctuation.braces.sigma",
          "match": "[{}]"
        },
        {
          "name": "punctuation.terminator.statement.sigma",
          "match": ";"
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.sigma",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
        }
      ]
    }
  }
}
