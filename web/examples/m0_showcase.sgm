// Showcase Sigma (.sgm) — Todos os Tipos Primitivos e Interpolação de Strings
var iteracoes := 1_000_000;
var taxa_aprendizado : float = 0.01f;
var erro_residual : double = 1.25e-6d;
var constante_exata : decimal = 3.141592653589793238462643383279m;
var convergiu := true;
var simbolo : char = 'Σ';
