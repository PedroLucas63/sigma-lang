# Testes do recurso de parâmetros ref e out (Shallow Const, ref, out, out var)
# Paridade absoluta entre VM e backend C99

# --- 1. Shallow Const em parâmetros padrão por valor ---
act mutate_elem(arr: int[3]) {
    arr[0] = 99;
}

var v := [1, 2, 3];
mutate_elem(v);
assert(v[0], 99);

# Reatribuir parâmetro por valor diretamente é proibido (E0107)
assert_error("E0107", "fun test(a: int): int { a = 10; return a; }");
assert_error("E0107", "fun test(a: int): int { a++; return a; }");
assert_error("E0107", "act test(arr: int[2]) { arr = [1, 2]; }");

# --- 2. Parâmetros 'ref' e mutação das variáveis do chamador ---
act swap_int(ref a: int, ref b: int) {
    var t := a;
    a = b;
    b = t;
}

var x := 10;
var y := 20;
swap_int(ref x, ref y);
assert(x, 20);
assert(y, 10);

act inc_ref(ref a: int) {
    a++;
}
inc_ref(ref x);
assert(x, 21);

# Strings com ref
act append_str(ref s: string, suffix: string) {
    s = s + suffix;
}
var msg := "hello";
append_str(ref msg, " world");
assert(msg, "hello world");

# Bools com ref
act toggle_bool(ref b: bool) {
    b = not b;
}
var flag := true;
toggle_bool(ref flag);
assert(flag, false);
toggle_bool(ref flag);
assert(flag, true);

# Floats com ref
act scale_float(ref f: float, factor: float) {
    f = f * factor;
}
var f_val := 2.5f;
scale_float(ref f_val, 2.0f);
assert(f_val, 5.0f);

# Erros de uso em 'ref'
assert_error("E0115", "fun f(ref a: int): int { return a; } var r := f(ref 10);");
assert_error("E0115", "fun f(ref a: int): int { return a; } const c := 10; var r := f(ref c);");
assert_error("E0116", "fun f(ref a: int): int { return a; } var x := 10; var r := f(x);");
assert_error("E0116", "fun f(a: int): int { return a; } var x := 10; var r := f(ref x);");

# --- 3. Parâmetros 'out' e atribuição definitiva ---
fun dividir(a: int, b: int, out resto: int): int {
    resto = a % b;
    return a // b;
}

var r := 0;
var q := dividir(10, 3, out r);
assert(q, 3);
assert(r, 1);

# out var com inferência automática de tipo no escopo do chamador
var q2 := dividir(20, 6, out var resto2);
assert(q2, 3);
assert(resto2, 2);

# out var com anotação explícita de tipo
var q3 := dividir(35, 4, out var resto3: int);
assert(q3, 8);
assert(resto3, 3);

# Procedimento com múltiplos out var
act div_mod(a: int, b: int, out quoc: int, out rem: int) {
    quoc = a // b;
    rem = a % b;
}

div_mod(47, 5, out var q4, out var r4);
assert(q4, 9);
assert(r4, 2);

# Erro E0117: parâmetro 'out' não atribuído antes de retornar
assert_error("E0117", "fun f(a: int, out b: int): int { return a; }");
assert_error("E0117", "fun f(a: int, out b: int): int { if (a > 0) { b = 1; return a; } return 0; }");
assert_error("E0117", "act f(a: int, out b: int) { if (a > 0) { b = 1; } }");

# Erros de uso em 'out'
assert_error("E0116", "fun f(out a: int): int { a = 1; return a; } var x := 0; var r := f(x);");
assert_error("E0116", "fun f(out a: int): int { a = 1; return a; } var x := 0; var r := f(ref x);");
assert_error("E0116", "fun f(ref a: int): int { a = 1; return a; } var x := 0; var r := f(out x);");
assert_error("E0104", "fun f(out a: int): int { a = 1; return a; } var r := f(out var x: string);");
assert_error("E0103", "fun f(out a: int): int { a = 1; return a; } var x := 10; var r := f(out var x);");

# --- 4. Proibição de captura de 'ref'/'out' em closures (E0118) ---
assert_error("E0118", "fun outer(ref a: int): int { fun inner(): int { return a; } return inner(); }");
assert_error("E0118", "fun outer(out a: int): int { fun inner(): int { a = 10; return a; } a = inner(); return a; }");

println("All ref/out parameter tests passed!");
