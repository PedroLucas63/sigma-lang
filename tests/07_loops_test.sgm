# ==============================================================================
# Suíte de Testes: Estruturas de Repetição (while, for, foreach, break, continue)
# ==============================================================================

# 1. Laço while (<bool-expr>) <stmt>
var w_i := 0;
var w_sum := 0;
while (w_i < 6) {
  w_sum += w_i;
  w_i++;
}
assert(w_sum, 15, "Soma de 0..5 com while");
assert(w_i, 6, "Valor final do contador w_i após while");

# while sem chaves (instrução única)
var w_single := 1;
while (w_single < 32) w_single *= 2;
assert(w_single, 32, "while de linha única dobrando valor");

# 2. Laço for (<init>; <bool-expr>; <step>) <stmt>
var f_sum := 0;
for (var i := 1; i <= 10; i++) {
  f_sum += i;
}
assert(f_sum, 55, "Soma de 1..10 com for e var local");

# Reuso do identificador 'i' após o término do for (escopo isolado)
var i := 999;
assert(i, 999, "Variável i do for não vaza para fora do laço");

# for com expressão no inicializador
var ext := 0;
var ext_acc := 0;
for (ext = 10; ext > 0; ext -= 3) ext_acc += ext;
assert(ext_acc, 22, "for usando variável existente na expressão inicial");
assert(ext, -2, "Valor final de ext após for");

# for com desempacotamento no inicializador
var pair_acc := 0;
for (var (left, right) := (1, 5); left <= right; left++) {
  pair_acc += left * right;
  right--;
}
assert(pair_acc, 22, "for com desempacotamento var (left, right) no init");

# 3. Laço foreach (var/const <binding> [:<type>] in <array>) <stmt>
var primes := [2, 3, 5, 7, 11];
var prime_sum := 0;
foreach (var p : int in primes) {
  prime_sum += p;
}
assert(prime_sum, 28, "foreach simples com anotação de tipo explícita");

# foreach com desempacotamento de tuplas (caso de uso do usuário)
var l := [(10, 20), (20, 30)];
var tuple_sums := [0, 0];
var idx := 0;
foreach (var (a, b) in l) {
  tuple_sums[idx] = a + b;
  idx++;
}
assert(tuple_sums, [30, 50], "foreach (var (a, b) in l) somando elementos das tuplas");

# foreach com const, tipo explícito e curinga '_'
var records := [(100, "ignorado", 2.5d), (200, "também", 3.5d)];
var total_weight := 0.0d;
var total_id := 0;
foreach (const (id, _, w) : (int, string, double) in records) {
  total_id += id;
  total_weight += w;
}
assert(total_id, 300, "foreach com const e curinga _ (soma de ids)");
assert(total_weight, 6.0d, "foreach com const e curinga _ (soma de doubles)");

# foreach desempacotando array de arrays
var matrix := [[1, 2, 3], [4, 5, 6]];
var diag_sum := 0;
foreach (var (c0, _, c2) in matrix) {
  diag_sum += c0 + c2;
}
assert(diag_sum, 14, "foreach desempacotando elementos de matriz 2x3");

# 4. Comandos break e continue (sem rótulo)
var b_sum := 0;
for (var k := 0; k < 100; k++) {
  if (k % 2 == 0) continue;
  if (k > 7) break;
  b_sum += k;
}
assert(b_sum, 16, "for com continue (ímpares) e break (> 7): 1 + 3 + 5 + 7 = 16");

var fe_filtered := 0;
foreach (var n in [5, 10, 15, 20, 25]) {
  if (n == 10) continue;
  if (n == 20) break;
  fe_filtered += n;
}
assert(fe_filtered, 20, "foreach com continue e break: 5 + 15 = 20");

# 5. Laços rotulados (<label>:) com break <label> e continue <label>
var found_i := -1;
var found_j := -1;
for1: for (var r := 0; r < 10; r++) {
  for2: foreach (var j in [5, 10, 20, 30]) {
    if (j == 20 and r == 2) {
      found_i = r;
      found_j = j;
      break for1;
    }
  }
}
assert(found_i, 2, "break for1 interrompe o laço externo na linha 2");
assert(found_j, 20, "break for1 interrompe o laço externo no valor 20");

var outer_steps := 0;
var inner_steps := 0;
externo: for (var a := 0; a < 4; a++) {
  outer_steps++;
  var temp_inside := a * 10;
  interno: while (temp_inside >= 0) {
    inner_steps++;
    if (a % 2 == 1) continue externo;
    break interno;
  }
}
assert(outer_steps, 4, "continue externo avança corretamente para o step do for externo");
assert(inner_steps, 4, "corpo interno executou 1 vez por iteração externa");

# Verifica que variáveis internas foram limpas da memória mesmo após break <label>
var temp_inside := 777;
assert(temp_inside, 777, "Variável de bloco interno não vaza após break/continue rotulado");

# 6. Diagnósticos de Erro Sintático e Semântico em Laços
assert_error("E0104", "while (123) {}", "Condição de while não-booleana");
assert_error("E0104", "for (var i := 0; i + 1; i++) {}", "Condição de for não-booleana");
assert_error("E0104", "foreach (var x in (10, 20)) {}", "foreach sobre tupla em vez de array");
assert_error("E0104", "foreach (var x : string in [1, 2, 3]) {}", "Tipo anotado incompatível no foreach");
assert_error("E0104", "foreach (var (a, b, c) in [(1, 2), (3, 4)]) {}", "Aridade incorreta no desempacotamento do foreach");
assert_error("E0104", "foreach (var (a, b) in [10, 20, 30]) {}", "Desempacotamento de elemento escalar no foreach");
assert_error("E0102", "for (var z := 0; z < 3; z++) {} println(z);", "Uso de variável do for fora de seu escopo");
assert_error("E0102", "foreach (var elem in [1, 2]) {} println(elem);", "Uso de variável do foreach fora de seu escopo");
assert_error("E0103", "var dup := 0; for (var dup := 0; dup < 3; dup++) {}", "Shadowing de variável externa no for");
assert_error("E0103", "var dup := 0; foreach (var dup in [1, 2]) {}", "Shadowing de variável externa no foreach");
assert_error("E0103", "foreach (var (a, a) in [(1, 2)]) {}", "Variável duplicada no padrão do foreach");
assert_error("E0103", "lbl: while (true) { lbl: for (var k := 0; k < 1; k++) {} }", "Rótulo de laço duplicado em laço aninhado");
assert_error("E0107", "foreach (const x in [1, 2, 3]) { x = 10; }", "Mutação de variável const no foreach");
assert_error("E0107", "for (const c := 0; c < 3; c++) {}", "Incremento de constante no for");
assert_error("E0109", "break;", "break fora de qualquer laço");
assert_error("E0109", "continue;", "continue fora de qualquer laço");
assert_error("E0109", "while (true) { break inexistente; }", "break apontando para rótulo inexistente");
assert_error("E0109", "while (true) { continue inexistente; }", "continue apontando para rótulo inexistente");
assert_error("E0002", "lbl: var x := 10;", "Rótulo aplicado a declaração em vez de laço");
assert_error("E0002", "foreach (x in [1, 2]) {}", "foreach sem var/const");
